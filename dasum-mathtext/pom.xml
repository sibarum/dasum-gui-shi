    <!-- Math notation typesetter: a semantic math IR + a shared em-layout pass, projected to either
         backend (OpenGL scene layers or self-contained SVG) by a dumb tree-walk. All the formatting
         logic lives once, in layout; the backends only place glyphs and rules. -->
    <artifactId>dasum-mathtext</artifactId>

    <dependencies>
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-core</artifactId>
        </dependency>
        <!-- The OpenGL backend emits scene Layers (TextLayer / LineLayer). -->
        <dependency>
            <groupId>sibarum.dasum.gui</groupId>
            <artifactId>dasum-vis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
